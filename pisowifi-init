#!/bin/sh /etc/rc.common
# Ensures /etc/pisowifi exists with valid config/state before other
# services start relying on it. Idempotent - safe to run every boot.

START=19
STOP=90

USE_PROCD=0

start() {
  . /www/cgi-bin/lib/pisowifi-common.sh
  pisowifi_bootstrap
  # Freeze all active sessions so a brownout does not drain remaining time
  pause_all_active_sessions
  logger -t pisowifi "boot check complete - config/state validated, sessions frozen for brownout protection"
 ## logger -t pisowifi "boot check complete - config/state validated"
}
